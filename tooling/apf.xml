<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">

  <mime-type type="image/x-aperture-picture">
    <comment>Aperture Picture Format image</comment>
    <glob pattern="*.apf"/>
    <magic priority="100">
      <match value="APERTURE IMAGE FORMAT (c) 1985" type="string" offset="0" />
    </magic>
  </mime-type>
  
  <mime-type type="image/x-aperture-picture-1993">
    <comment>Aperture Picture Format 2 image</comment>
    <glob pattern="*.apf2"/>
    <glob pattern="*.af2"/>
    <glob pattern="*.aif2"/>
    <magic priority="80">
      <match value="APERTURE IMAGE FORMAT (c) 1993" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="image/x-aperture-picture-1994">
    <comment>Aperture Picture Format 2 (1994) image</comment>
    <glob pattern="*.apf2"/>
    <glob pattern="*.af2"/>
    <glob pattern="*.aif2"/>
    <magic priority="90">
      <match value="APERTURE IMAGE FORMAT (c) 1994" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="image/x-aperture-picture-2000">
    <comment>Aperture Picture Format 2 (2000) image</comment>
    <glob pattern="*.a2k"/>
    <glob pattern="*.apf2"/>
    <magic priority="100">
      <match value="APERTURE IMAGE FORMAT (c) 2000" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="image/x-ota">
    <comment>Over The Air bitmap image</comment>
    <glob pattern="*.otb"/>
    <glob pattern="*.ota"/>
    <glob pattern="*.otab"/>
  </mime-type>

  <mime-type type="image/x-bruhiff">
    <comment>Blazingly rapid uncompressed harebrained image</comment>
    <glob pattern="*.bruh"/>
  </mime-type>
  
  <mime-type type="image/x-mqif">
    <comment>Mari's QOI-Like Interchange Format image</comment>
    <glob pattern="*.mqif"/>
    <glob pattern="*.mqi"/>
    <magic priority="100">
      <match value="QIF26a" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="image/x-kqi">
    <comment>KQ image</comment>
    <glob pattern="*.kqi"/>
    <magic priority="100">
      <match value="KQIF" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="image/x-flif">
    <comment>FLIF image</comment>
    <glob pattern="*.flif"/>
    <glob pattern="*.flf"/>
    <magic priority="100">
      <match value="FLIF" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="audio/x-aperture-audio">
    <comment>Aperture Audio Format File</comment>
    <glob pattern="*.aaf" weight="40"/>
    <glob pattern="*.aaff" weight="60"/>
    <magic priority="80">
      <match value="APERTURE AUDIO FORMAT (c) 1986" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="image/x-aperture-picture-compressed+gzip">
    <comment>Gzip-Compressed Aperture Picture Format image</comment>
    <glob pattern="*.a2g"/>
    <magic priority="90">
      <match value="APF2gz" type="string" offset="0" />
    </magic>
  </mime-type>
  <mime-type type="image/x-aperture-picture-compressed+x-bzip2">
    <comment>Bzip2-Compressed Aperture Picture Format image</comment>
    <glob pattern="*.a2b"/>
    <magic priority="90">
      <match value="APF2b2" type="string" offset="0" />
    </magic>
  </mime-type>
  <mime-type type="image/x-aperture-picture-compressed+x-squeeze">
    <comment>Squeeze-Compressed Aperture Picture Format image</comment>
    <glob pattern="*.aq2"/>
    <glob pattern="*.aqf"/>
    <magic priority="90">
      <match value="APF2sq" type="string" offset="0" />
    </magic>
  </mime-type>
  <mime-type type="image/x-aperture-picture-compressed+x-asciipak">
    <comment>ASCIIPak-Compressed Aperture Picture Format image</comment>
    <glob pattern="*.a2c"/>
    <glob pattern="*.apc"/>
    <glob pattern="*.a2ci"/>
    <magic priority="90">
      <match value="APF2ci" type="string" offset="0" />
    </magic>
  </mime-type>

  <mime-type type="application/x-squeeze">
    <comment>Squeezed File</comment>
    <glob pattern="*.sq"/>
    <magic priority="85">
      <match type="string" offset="0" value="v\xff"/>
    </magic>
  </mime-type>

</mime-info>
